rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mailforint@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGameTrack(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.difficulty is string && data.difficulty.size() <= 60
        && data.stages is list && data.stages.size() <= 50;
    }

    function isValidTrackRevision() {
      return !('revision' in resource.data)
        || !(resource.data.revision is number)
        || resource.data.revision == 0
        || (
          'revision' in incoming()
          && incoming().revision is number
          && incoming().revision > resource.data.revision
        );
    }

    function isValidStudentRecord(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.studentName is string && data.studentName.size() <= 150
        && data.trackId is string && data.trackId.size() <= 128
        && data.score is number && data.score >= 0;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check document
    match /test/connection {
      allow get: if true;
    }

    // Game tracks: educational levels created and customized by teachers
    // Split get and list so collection-level onSnapshot list queries succeed.
    // Updates enforce monotonic revision so old cached browser tabs cannot reset newer cloud data.
    match /game_tracks/{trackId} {
      allow list: if true;
      allow get: if isValidId(trackId);
      allow create: if isValidId(trackId) && isValidGameTrack(incoming());
      allow update: if isValidId(trackId) && isValidGameTrack(incoming()) && isValidTrackRevision();
      allow delete: if isValidId(trackId);
    }

    // Student progress telemetry
    match /student_records/{recordId} {
      allow list: if true;
      allow get: if isValidId(recordId);
      allow create, update: if isValidId(recordId) && isValidStudentRecord(incoming());
      allow delete: if isValidId(recordId);
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
